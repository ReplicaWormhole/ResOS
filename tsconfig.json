{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true,
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src"]
}
