{
  "name": "resos",
  "version": "0.4.0",
  "private": true,
  "description": "A local research IDE and Codex notebook",
  "author": "ResOS contributors",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/main/main.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "npm run build && electron .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "build": "tsc && node scripts/copy-assets.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "package:linux": "npm run build && electron-builder --linux deb --x64 --publish never",
    "test:desktop": "node --test tests/desktop-smoke.mjs",
    "prebuild": "node scripts/clean-build.mjs"
  },
  "build": {
    "appId": "com.resos.desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**"
    ],
    "linux": {
      "executableName": "resos",
      "category": "Development",
      "maintainer": "ResOS maintainers",
      "syncDesktopName": true
    },
    "deb": {
      "packageCategory": "devel"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "playwright-core": "1.65.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "homepage": "https://github.com/ReplicaWormhole/ResOS",
  "productName": "ResOS",
  "desktopName": "resos.desktop",
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "codemirror": "6.0.2"
  }
}
